<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides for building under Wine (ci/build.sh), imported into every C++
  project via ForceImportBeforeCppTargets, so after the projects' own settings.

  Code analysis (/analyze, PREfast) can't parse its ruleset files under Wine
  and fails with C1259. It doesn't change the generated binaries.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RunCodeAnalysis>false</RunCodeAnalysis>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <EnablePREfast>false</EnablePREfast>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
